---
import BaseLayout from '../layouts/BaseLayout.astro';
import Colophon from '../components/Colophon.astro';
import Spectrum from '../components/Spectrum.astro';
import { getEntries, monthName, monthYear, topics } from '../lib/entries';

const entries = await getEntries();
// The band is what the posts are made of: a line per topic, heavier the more posts carry it.
// Hovering a line names the topic and fades the posts without it.
const { spectrum, topics: lines } = await topics();

// Feature the newest entry that has an image; posts without one stay in the archive only.
const featured = entries.find(e => e.image);
const featuredLabel = featured === entries[0] ? 'Latest' : 'Featured';

// The archive lists everything except the featured entry.
const archive = entries.filter(e => e !== featured);
const years = [...new Set(archive.map(e => e.date.getFullYear()))];
---
<BaseLayout title="Work - Alessandro Salo" description="Projects and blog posts on rendering, GPUs and making things run fast.">

  <article class="doc">
    <header class="head head--page head--docked">
      <h1>Work.</h1>
      <p class="head-sub">Projects and blog posts on rendering, GPUs and making things run fast.</p>
    </header>

    <!-- The topic band docks at the top of the window while you scroll, so hovering a topic fades the posts in view. -->
    <span class="tl-sentinel" aria-hidden="true"></span>
    <div class="tl-dock">
      <div class="tl tl--page">
        <Spectrum spectrum={spectrum} class="spec--page" main />
        <div class="tl-posts">
          {lines.map(t => (
            <span class:list={['tl-post', t.edge && `tl-${t.edge}`]} data-topic={t.tag} style={`--x:${t.x};--c:${t.c}`}>
              <span class="tl-label">#{t.label}<span class="tl-when">{t.count} {t.count === 1 ? 'post' : 'posts'}</span></span>
            </span>
          ))}
        </div>
      </div>
    </div>

    {featured && (
      <a class="feat" href={featured.href} data-spectrum={featured.spectrum} data-tags={featured.tags.join(' ').toLowerCase()}>
        <div class="feat-img">
          <img src={featured.image} alt="" decoding="async" />
          <div class="feat-ov">
            <span class="feat-k">{featuredLabel} - {monthYear(featured.date)} - {featured.kind}</span>
            <span class="feat-t">{featured.title}</span>
            <span class="feat-hint" aria-hidden="true">Hover for details</span>
            <div class="feat-body">
              <span class="feat-d">{featured.summary}</span>
              <span class="feat-meta"><span>{featured.stack}</span><span class="feat-read">Read&#8201;&#8594;</span></span>
            </div>
          </div>
        </div>
      </a>
    )}

    {archive.length > 0 && (
      <section aria-labelledby="archive-h">
        <h2 class="smallcaps arch-h" id="archive-h">Archive</h2>
        <div class="arch-grid">
          <div>
            {years.map(year => (
              <div class="yr">
                <h3 class="smallcaps yr-h">{year}</h3>
                <div>
                  {archive.filter(e => e.date.getFullYear() === year).map(e => (
                    <a class="row" href={e.href} data-spectrum={e.spectrum} data-tags={e.tags.join(' ').toLowerCase()}
                       data-img={e.image ?? ''} data-title={e.title} data-summary={e.summary}
                       data-meta={`${e.kind} - ${monthYear(e.date)}`} data-stack={e.stack}>
                      <span>
                        <span class="row-t">{e.title}</span>
                        <span class="row-s">{e.stack || e.summary}</span>
                      </span>
                      <span class="smallcaps row-k">{e.kind} - {monthName(e.date)}</span>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <!-- Preview card in the right margin (wide screens only); shown while an entry is hovered. -->
          <aside class="card" aria-hidden="true">
            <div class="card-in">
              <Spectrum spectrum="hydrogen" class="spec--v" />
              <div class="card-img"></div>
              <span class="smallcaps card-m"></span>
              <span class="card-t"></span>
              <span class="card-d"></span>
              <span class="card-s"></span>
            </div>
          </aside>
        </div>
      </section>
    )}

    <Colophon />
  </article>

  <script>
    import { show as showSpectrum } from '../lib/spectrum';

    function initCard() {
      const card = document.querySelector<HTMLElement>('.card');
      const rows = document.querySelectorAll<HTMLAnchorElement>('.row');
      if (!card || !rows.length) return;

      const img = card.querySelector('.card-img')!;
      const set = (sel: string, text = '') => { card.querySelector(sel)!.textContent = text; };
      let current: HTMLAnchorElement | null = null;
      let hideTimer: number | undefined;

      const show = (row: HTMLAnchorElement) => {
        clearTimeout(hideTimer);
        card.classList.add('on');
        if (row === current) return;
        current?.classList.remove('cur');
        current = row;
        row.classList.add('cur');
        const { img: src, title, summary, meta, stack, spectrum } = row.dataset;
        const band = card.querySelector<HTMLElement>('.spec');
        // Each post's sections fade in where they belong (never sliding over from the last post's).
        if (band && spectrum) showSpectrum(band, spectrum);
        if (src) {
          const el = document.createElement('img');
          el.src = src;
          el.alt = '';
          img.replaceChildren(el);
        } else {
          const ph = document.createElement('span');
          ph.className = 'card-ph';
          ph.textContent = 'Blog';
          img.replaceChildren(ph);
        }
        set('.card-m', meta);
        set('.card-t', title);
        set('.card-d', summary);
        set('.card-s', stack);
      };

      // Short delay so moving between rows (or across the gap between years) doesn't flicker.
      const hide = () => {
        clearTimeout(hideTimer);
        hideTimer = window.setTimeout(() => {
          card.classList.remove('on');
          current?.classList.remove('cur');
          current = null;
        }, 150);
      };

      rows.forEach(row => {
        row.addEventListener('mouseenter', () => show(row));
        row.addEventListener('mouseleave', hide);
        row.addEventListener('focus', () => show(row));
        row.addEventListener('blur', hide);
      });
    }

    document.addEventListener('astro:page-load', initCard);

    // Hovering a topic line fades the posts that don't carry it.
    function initTopics() {
      const doc = document.querySelector<HTMLElement>('.doc');
      if (!doc) return;
      document.querySelectorAll<HTMLElement>('.tl-post[data-topic]').forEach(line => {
        const tag = line.dataset.topic!;
        const band = document.querySelector<HTMLElement>('.spec[data-main]');
        const i = [...line.parentElement!.children].indexOf(line);
        line.addEventListener('pointerenter', () => {
          // Its own line on the band lights up, like a post lights up its topics.
          band?.classList.add('spec--focus', 'spec--solo');
          band?.children[i]?.classList.add('is-lit');
          doc.classList.add('is-topic');
          doc.querySelectorAll<HTMLElement>('[data-tags]').forEach(el =>
            el.classList.toggle('has-topic', el.dataset.tags!.split(' ').includes(tag)));
        });
        line.addEventListener('pointerleave', () => {
          band?.classList.remove('spec--focus', 'spec--solo');
          band?.children[i]?.classList.remove('is-lit');
          doc.classList.remove('is-topic');
        });
      });
    }
    document.addEventListener('astro:page-load', initTopics);

    // Mark the band once it has docked, so it can draw its backdrop.
    let docked: IntersectionObserver | undefined;
    function initDock() {
      docked?.disconnect();
      const sentinel = document.querySelector('.tl-sentinel');
      const dock = document.querySelector<HTMLElement>('.tl-dock');
      if (!sentinel || !dock) return;
      docked = new IntersectionObserver(([e]) => dock.classList.toggle('is-docked', !e.isIntersecting && e.boundingClientRect.top < 0));
      docked.observe(sentinel);
    }
    document.addEventListener('astro:page-load', initDock);
  </script>

</BaseLayout>
