---
import BaseLayout from '../layouts/BaseLayout.astro';
import Colophon from '../components/Colophon.astro';

const now = {
  updated: 'July 2026',
  items: [
    'Reading "Physically Based Rendering: From Theory to Implementation"',
    'Looking for a thesis project',
  ],
};

const interests = ['Real-time Rendering', 'Game Engines', 'Hardware', 'Simulations', 'Optimization'];

const education = [
  { degree: 'MSc Game and Media Technology', where: 'Utrecht University', when: '2025–now' },
  { degree: 'Computational Science and Engineering', where: 'EPFL', when: '2024–25' },
  { degree: 'BSc Physics and Liberal Arts & Sciences (Mathematics)', where: 'Utrecht University', when: '2020–24' },
];
---
<BaseLayout title="About - Alessandro Salo">

  <article class="doc">
    <header class="about-head">
      <div class="about-photo">
        <img src="/assets/me.jpeg" alt="A portrait of Alessandro Salo." width="746" height="1066" decoding="async" />
      </div>
      <div>
        <h1>Hi, I'm Alessandro.</h1>
        <p class="about-intro"><em>I am committed to making games beautiful</em>. Not necessarily graphically - despite aspiring to be a graphics and engine programmer - but as experiences. So... why am I not a game designer? Well, I have too much fun at the bottom of the rabbit hole. And, the bottom of that rabbit hole, to me, is low-level languages and hardware-level optimizations. I like the nitty-gritty details.</p>
        <p class="about-cv"><a class="ulink" href="/assets/cv.pdf">Download my CV&#8201;&#8595;</a></p>
      </div>
    </header>

    <div class="about-facts">
      <section>
        <h2 class="smallcaps">Now <span class="about-updated">- {now.updated}</span></h2>
        <ul>{now.items.map(item => <li>{item}</li>)}</ul>
      </section>
      <section>
        <h2 class="smallcaps">Interests</h2>
        <ul>{interests.map(item => <li>{item}</li>)}</ul>
      </section>
      <section>
        <h2 class="smallcaps">Education</h2>
        <ul>{education.map(e => <li>{e.degree}<span class="about-sub">{e.where}, {e.when}</span></li>)}</ul>
      </section>
    </div>

    <details class="about-more">
      <summary>The longer story</summary>
      <p>Currently, I'm a <em>Game and Media Technology Master's student</em> at Utrecht University. Previously, I finished a <em>double-degree Bachelor's in mathematics and physics</em> - where I did my final thesis on determining fluid-crystal phase boundaries of binary hard spheres using direct coexistence simulations (written in C). The work I did was then continued and finalized by a PhD student and published.</p>
      <p>Continuing in this direction, I started a <em>Masters at EPFL in computational science and engineering</em>. A year in, I realized that my passion was really in games - stemming from teenage year attempts at making games and making an engine. And <em>now here I am, having a blast endlessly trying to keep up with this fast-paced evolving field.</em></p>
    </details>

    <Colophon />
  </article>

</BaseLayout>
