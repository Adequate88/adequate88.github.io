---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Colophon from '../../components/Colophon.astro';
import '../../styles/prose.css';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, date, excerpt, tags, image, readtime } = post.data;

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<BaseLayout title={`${title} — Alessandro Salo`} description={excerpt} image={image}>

  <article class="doc">

    <nav class="post-top-nav">
      <a href="/work" class="post-back">&#8592; This ain't it? Go back.</a>
    </nav>

    <header class="post-head">
      <p class="smallcaps post-meta">Blog - <time datetime={date.toISOString()}>{fmtDate(date)}</time>{readtime && ` - ${readtime}`}</p>
      <h1>{title}</h1>
      <p class="lead">{excerpt}</p>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>

    {image && <img src={image} alt="" class="post-hero-image" decoding="async" />}

    <div class="prose">
      <Content />
    </div>

    <footer class="post-foot">
      <a href="/work" class="post-back">&#8592; Thanks for reading:)</a>
    </footer>

    <Colophon />
  </article>

</BaseLayout>
