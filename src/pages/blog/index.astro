---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Colophon from '../../components/Colophon.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sorted = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const byYear = sorted.reduce((acc, post) => {
  const year = post.data.date.getFullYear().toString();
  if (!acc[year]) acc[year] = [];
  acc[year].push(post);
  return acc;
}, {} as Record<string, typeof sorted>);

const years = Object.keys(byYear).sort((a, b) => Number(b) - Number(a));

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
---
<BaseLayout title="Blog - Alessandro Salo" description="Dev logs and notes on graphics problems.">

  <article class="doc">
    <header class="head head--page">
      <span class="kicker"><span class="smallcaps">Philosophy?</span></span>
      <h1>Writing<span class="dot">.</span></h1>
    </header>

    {years.map(year => (
      <section class="sec">
        <div class="sec-h"><span class="smallcaps">{year}</span><span class="n">{byYear[year].length}</span></div>
        <div class="wlist">
          {byYear[year].map(post => (
            <a class="wrow" href={`/blog/${post.slug}`}
              <span class="wt">{post.data.pinned && <span style="color:var(--accent)">&#9733; </span>}{post.data.title}</span>
              <span class="wm2">{fmtDate(post.data.date)}{post.data.readtime ? ` · ${post.data.readtime}` : ''}</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    {allPosts.length === 0 && (
      <section class="sec"><p class="wdesc">No posts yet &mdash; check back soon.</p></section>
    )}

    <Colophon />
  </article>

</BaseLayout>
