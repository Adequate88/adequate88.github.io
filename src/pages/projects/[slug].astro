---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Colophon from '../../components/Colophon.astro';
import Contents from '../../components/Contents.astro';
import Spectrum from '../../components/Spectrum.astro';
import { getCollection } from 'astro:content';
import { monthYear, toPublicPath } from '../../lib/entries';
import { flow, flowSpectrum } from '../../lib/flow';
import '../../styles/figures.css';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await project.render();
const { title, subtitle, description, tags, year, month, image, video, github } = project.data;
const date = year ? monthYear(new Date(Number(year), Number(month ?? 1) - 1, 1)) : undefined;
const shareImage = toPublicPath(image);
const heroVideo = toPublicPath(video);
// Where each section falls in the text: their colours, the band's lines and the rail's spacing.
const marks = flow(project.body);
const spectrum = flowSpectrum(project.body) ?? `/projects/${project.slug}`;
---
<BaseLayout title={`${title} — Alessandro Salo`} description={description} image={shareImage}>

  <article class="doc">

    <nav class="post-top-nav">
      <a href="/work" class="post-back">&#8592; Woops, wrong page?</a>
    </nav>

    <header class="post-head">
      <p class="smallcaps post-meta">Project{date && ` - ${date}`}</p>
      <h1>{title}</h1>
      <Spectrum spectrum={spectrum} main />
      {subtitle && <p class="post-subtitle">{subtitle}</p>}
      <p class="lead">{description}</p>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      )}
      {github && (
        <p class="post-source">
          <a href={github} target="_blank" rel="noopener" class="post-back">Check out the source code on github:)&#8201;&#8599;</a>
        </p>
      )}
    </header>

    {heroVideo
      ? <video src={heroVideo} poster={shareImage} class="post-hero-image" autoplay muted loop playsinline aria-hidden="true"></video>
      : shareImage && <img src={shareImage} alt="" class="post-hero-image" decoding="async" />}

    <Contents headings={headings} marks={marks} />

    <div class="prose">
      <Content />
    </div>

    <footer class="post-foot">
      <a href="/work" class="post-back">&#8592; All done? Check out some other projects!</a>
    </footer>

    <Colophon />
  </article>

</BaseLayout>

<script>
  import { initFigures } from '../../lib/figures';
  import { initContents } from '../../lib/contents';
  document.addEventListener('astro:page-load', initFigures);
  document.addEventListener('astro:page-load', initContents);

  // A <video> swapped in by a view transition never loads (it was parsed in a detached
  // document), so autoplay never fires. Reload and start it after every page load.
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLVideoElement>('video[autoplay]').forEach(v => {
      if (v.error || v.readyState === 0) v.load();
      v.play().catch(() => {});
    });
  });
</script>
