---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Colophon from '../../components/Colophon.astro';
import '../../styles/prose.css';
import { getCollection } from 'astro:content';
import { monthYear } from '../../lib/entries';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const { title, subtitle, description, tags, year, month, image, github } = project.data;
const date = year ? monthYear(new Date(Number(year), Number(month ?? 1) - 1, 1)) : undefined;
const shareImage = image ? '/' + image.replace(/^\//, '') : undefined;
---
<BaseLayout title={`${title} — Alessandro Salo`} description={description} image={shareImage}>

  <article class="doc">

    <nav class="post-top-nav">
      <a href="/work" class="post-back">&#8592; Woops, wrong page?</a>
    </nav>

    <header class="post-head">
      <p class="smallcaps post-meta">Project{date && ` - ${date}`}</p>
      <h1>{title}</h1>
      {subtitle && <p class="post-subtitle">{subtitle}</p>}
      <p class="lead">{description}</p>
      {tags.length > 0 && (
        <div class="post-tags">
          {tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      )}
      {github && (
        <p class="post-source">
          <a href={github} target="_blank" rel="noopener" class="post-back">Check out the source code on github:)&#8201;&#8599;</a>
        </p>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-foot">
      <a href="/work" class="post-back">&#8592; All done? Check out some other projects!</a>
    </footer>

    <Colophon />
  </article>

</BaseLayout>
