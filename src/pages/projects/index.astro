---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Colophon from '../../components/Colophon.astro';
import Plate from '../../components/Plate.astro';
import { getCollection } from 'astro:content';

const statusRank = { active: 0, completed: 1, archived: 2 } as const;
const projects = (await getCollection('projects')).sort((a, b) => {
  const r = statusRank[a.data.status] - statusRank[b.data.status];
  if (r !== 0) return r;
  return (b.data.year ?? '').localeCompare(a.data.year ?? '');
});

const statusClass = { active: 'in-progress', completed: 'completed', archived: 'archived' };

// Build the filter vocabulary from the tags that actually exist.
const tagCounts = new Map<string, number>();
for (const p of projects) for (const t of p.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const tagFilters = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
const archivedCount = projects.filter(p => p.data.status === 'archived').length;

// data-cat lets the client-side filter match a card. Include status keyword too.
const cat = (p: typeof projects[number]) =>
  [...p.data.tags, p.data.status === 'archived' ? 'archived' : ''].filter(Boolean).join(' ');
---
<BaseLayout title="Projects - Alessandro Salo" description="Selected real-time and offline rendering work.">

  <article class="doc">
    <header class="head head--page">
      <span class="kicker"><span class="smallcaps">Cool stuff I've made</span></span>
      <h1>Projects<span class="dot">.</span></h1>
    </header>

    

    <section class="sec">

      <div class="proj-filters">
        <span class="proj-filters-label">Filter &middot;</span>
        <button class="proj-filter active" data-filter="all">All &middot; {projects.length}</button>
        {tagFilters.map(([tag, count]) => (
          <button class="proj-filter" data-filter={tag}>{tag} &middot; {count}</button>
        ))}
        {archivedCount > 0 && (
          <button class="proj-filter" data-filter="archived">archived &middot; {archivedCount}</button>
        )}

      </div>

      <div class="wgrid">
        {projects.map((project, i) => (
          <a class="wcard" href={`/projects/${project.slug}`} data-cat={cat(project)}>
            <Plate
              image={project.data.image}
              alt={project.data.title}
            />
            <span class="wfoot">
              <span class="wname">{project.data.title} <span class="arr">&#8594;</span></span>
              <span class="wdesc">{project.data.description}</span>
              <span class="wtags">{project.data.tags.map(tag => <span class="tag">{tag}</span>)}</span>
              <span class:list={['wstat', statusClass[project.data.status]]}> {project.data.year}</span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <Colophon />
  </article>

  <script is:inline>
    (function () {
      const initFilters = () => {
        const btns = document.querySelectorAll('.proj-filter');
        const cards = document.querySelectorAll('.wcard');
        if (!btns.length) return;

        btns.forEach(btn => {
          btn.addEventListener('click', () => {
            btns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const f = btn.dataset.filter;
            cards.forEach(c => {
              c.style.display = (f === 'all' || (c.dataset.cat || '').split(' ').includes(f)) ? '' : 'none';
            });
          });
        });
      };

      initFilters();
      document.addEventListener('astro:page-load', initFilters);
    })();
  </script>
</BaseLayout>
