---
import BaseLayout from '../layouts/BaseLayout.astro';
import Colophon from '../components/Colophon.astro';
---
<BaseLayout title="404 — page not found - Alessandro Salo" description="The page you were looking for could not be found.">

  <article class="doc">
    <header class="head head--page">
      <span class="kicker"><span class="smallcaps">Error 404</span></span>
      <h1>Page not found.</h1>
      <p class="head-sub">This page didn&rsquo;t render. It may have moved, been renamed, or never existed in the first place.</p>
    </header>

    <pre class="nf-trace"><span>&gt;</span> GET {Astro.url.pathname}
<span>&gt;</span> 404 - resource not found
<span>&gt;</span> fallback &rarr; /</pre>

    <nav class="hero-links nf-links" aria-label="Site">
      <a class="ulink" href="/">Home</a><span class="sep" aria-hidden="true">/</span>
      <a class="ulink" href="/work">Work</a><span class="sep" aria-hidden="true">/</span>
      <a class="ulink" href="/about">About</a>
    </nav>

    <Colophon />
  </article>

</BaseLayout>

<style>
  .nf-trace {
    margin: 0 0 2rem;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: .8rem;
    line-height: 1.85;
    color: var(--text-muted);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .nf-trace span { color: var(--text-subtle); }
  .nf-links { justify-content: flex-start; margin-top: 0; }
</style>
