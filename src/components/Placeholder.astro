---
/**
 * Placeholder.astro — simple graphic placeholder component.
 */
interface Props {
  variant?: 'dark' | 'light';
  num?: string;
  label?: string;
}
const { variant = 'dark', label = 'no image · pending' } = Astro.props;
---
<span class:list={['ph', `ph--${variant}`]} aria-hidden="true">
  <svg class="ph-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
    <path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" />
  </svg>
  <span class="ph-label">{label}</span>
</span>

<style>
  .ph {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background-color: var(--surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
  }
  .ph-icon {
    width: 24px;
    height: 24px;
    color: var(--text-subtle);
    opacity: 0.6;
  }
  .ph-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
</style>
