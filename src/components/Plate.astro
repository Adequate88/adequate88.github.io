---
/**
 * Plate.astro — clean image card tile used in project highlights.
 * Renders an image when present, or a refined subtle placeholder frame.
 */
interface Props {
  num?: string;
  label?: string;
  badge?: string;
  image?: string;
  alt?: string;
}
const { label = 'no image · pending', badge, image, alt = '' } = Astro.props;
const resolvedImage = image
  ? /^https?:\/\//.test(image)
    ? image
    : `${import.meta.env.BASE_URL}${image.replace(/^\//, '')}`
  : undefined;
---
<span class="plate">
  {resolvedImage ? (
    <img src={resolvedImage} alt={alt} loading="lazy" decoding="async" />
  ) : (
    <span class="plate-ph">
      <svg class="plate-ph-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span class="plabel">{label}</span>
    </span>
  )}
  {badge && <span class="pbadge">{badge}</span>}
</span>
