---
interface Props {
  title?: string;
  description?: string;
  image?: string;        // path to an OG share image (defaults to the portrait)
}
const {
  title = 'Alessandro Salo — Graphics programmer',
  description = 'Graphics programmer and MSc Game & Media Technology student at Utrecht University — rendering, ray tracing, and optimization.',
  image = '/assets/me.jpeg',
} = Astro.props;

import '../styles/tokens.css';
import '../styles/document.css';
import '../styles/prose.css';
import '../styles/dark-mode.css';
import '../styles/focus-visible.css';
import '../styles/fraunhofer.css';
import { ViewTransitions } from 'astro:transitions';
import { timelineSpectrum, topics } from '../lib/entries';

// Hovering Home or Work slides the band to that page's own: the timeline of posts, and their topics.
const timeline = await timelineSpectrum();
const workSpectrum = (await topics()).spectrum;

const path = Astro.url.pathname;
// Each nav link is active for its own path plus any it absorbed (Work covers projects and posts).
const sections: Record<string, string[]> = { '/work': ['/work', '/projects', '/blog'], '/about': ['/about'] };
const isActive = (href: string) =>
  href === '/' ? path === '/' : (sections[href] ?? [href]).some(p => path.startsWith(p));

// Absolute URLs degrade gracefully if `site` isn't set in astro.config.mjs.
const base = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(path, base);
const ogImage = new URL(image, base);

const isDefaultImage = image === '/assets/me.jpeg';
const ogImageAlt = isDefaultImage ? 'Alessandro Salo — graphics programmer' : title;
const isHome = path === '/' || path === '';
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- No-flash theme boot: set data-theme before first paint, and re-apply
       after every View Transition swap (which otherwise resets <html> to the
       static data-theme="light"). astro:after-swap runs before paint, so the
       saved theme is restored without a flash. -->
  <script is:inline>
    (function () {
      function resolveTheme() {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          return t;
        } catch (e) {
          return 'light';
        }
      }
      function applyTheme() {
        document.documentElement.setAttribute('data-theme', resolveTheme());
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Alessandro Salo" />
  <link rel="canonical" href={canonical} />

  <!-- Icons -->
  <link rel="icon" type="image/svg+xml" href="/assets/logo-monogram.svg" />
  <meta name="theme-color" content="#ecebe5" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Alessandro Salo" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={ogImageAlt} />
  {isDefaultImage && <meta property="og:image:width" content="746" />}
  {isDefaultImage && <meta property="og:image:height" content="1066" />}
  <meta property="og:locale" content="en_US" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <!-- Feeds & discovery -->
  <link rel="alternate" type="application/rss+xml" title="Alessandro Salo — Work" href="/rss.xml" />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,200;0,300;0,400;1,300;1,400&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400;1,500&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <ViewTransitions />
  <slot name="head" />
</head>
<body class:list={[{ 'nav-hidden': isHome }]}>
  <button class="theme-toggle" type="button" aria-label="Toggle dark mode" aria-pressed="false" title="Switch to dark mode" transition:persist>
    <!-- A tiny spectrum previewing the other theme: emission (dark) or absorption (light) -->
    <span class="tt-spec" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="tt-label tt-dark" aria-hidden="true">Dark</span>
    <span class="tt-label tt-light" aria-hidden="true">Light</span>
  </button>

  <nav class="spine" transition:persist>
    <a class="spine-brand" href="/" id="brand-link">AS<b>.</b></a>
    <div class="spine-links">
      <a class:list={[{ active: isActive('/') }]} href="/" data-spectrum={timeline}>Home</a>
      <a class:list={[{ active: isActive('/work') }]} href="/work" data-match="/work /projects /blog" data-spectrum={workSpectrum}>Work</a>
      <a class:list={[{ active: isActive('/about') }]} href="/about" data-spectrum="helium">About</a>
      <a href="https://github.com/Adequate88" target="_blank" rel="noopener">GitHub&#8201;&#8599;</a>
    </div>
  </nav>

  <script>
    // The spine persists across view transitions, so its active state is refreshed client-side.
    document.addEventListener('astro:page-load', () => {
      const path = window.location.pathname;
      document.querySelectorAll<HTMLAnchorElement>('.spine-links a').forEach(link => {
        const href = link.getAttribute('href') ?? '';
        if (href.startsWith('http')) return;
        const prefixes = (link.dataset.match ?? href).split(' ');
        link.classList.toggle('active', href === '/' ? path === '/' : prefixes.some(p => path.startsWith(p)));
      });
    });

    // Brand link scrolls to top when already on the home page. Bound once: the spine is persisted.
    document.getElementById('brand-link')?.addEventListener('click', (e) => {
      if (window.location.pathname === '/') {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  </script>

  <script>
    // On arriving at a page, its band's lines fade in one by one. They never
    // slide over from the last page's band: every pattern means something, and
    // the in-between wouldn't.
    import { enter } from '../lib/spectrum';

    const band = () => document.querySelector<HTMLElement>('.spec[data-main]');

    document.addEventListener('astro:after-swap', () => {
      const b = band();
      if (!b) return;
      b.classList.add('spec--arrived');   // skip the home page's first-visit scan
      enter(b);
    });

    // Hovering never moves the lines, so they keep their meaning. While you
    // rest on anything clickable, a wave runs along the band, line by line, and
    // finishes its pass when you leave; a post on the Work page instead lights
    // up its topics' lines, rising in the same wave.
    // One pass runs the flare along the band once; while you're still hovering
    // when it ends, the next pass follows. A new hover between passes starts one
    // at once; leaving lets the current pass finish, so the wave never stops
    // halfway or falls out of step.
    let hovering = false, timer = 0, passEnd = 0;
    const pass = () => {
      const b = band();
      if (!b) return;
      b.classList.remove('spec--flare');
      void b.offsetWidth;   // restart the animation
      b.classList.add('spec--flare');
      // Lines start 35ms apart and pulse for 600ms; then a short rest before the next pass.
      const lines = [...b.children].filter(i => (i as HTMLElement).style.getPropertyValue('--on') === '1').length;
      const duration = 600 + Math.max(0, lines - 1) * 35;
      passEnd = performance.now() + duration;
      clearTimeout(timer);
      timer = window.setTimeout(() => { if (hovering) pass(); }, duration + 350);
    };
    const startWave = () => {
      hovering = true;
      if (performance.now() >= passEnd) pass();   // mid-pass, the next one follows on its own
    };
    const stopWave = () => { hovering = false; };

    // What hovering an element does to the band: nothing, or a wave (a post on
    // the Work page also lights up its topics, which ride the wave from their raised height).
    const topicLines = () => [...document.querySelectorAll<HTMLElement>('.tl-post[data-topic]')];
    const effect = (el: HTMLElement | null | undefined) => {
      if (!el || el.matches('.tl-post[data-topic]')) return 'none';   // topic lines handle themselves (work.astro)
      return el.dataset.tags !== undefined && topicLines().length ? 'topics' : 'wave';
    };
    const target = (node: EventTarget | Element | null | undefined) =>
      (node as Element | null)?.closest?.<HTMLElement>('a, button, summary, .tl-post');

    const hover = (e: Event, on: boolean) => {
      const el = target(e.target);
      const related = (e as PointerEvent | FocusEvent).relatedTarget;
      if (!el || (related instanceof Node && el.contains(related))) return;
      const b = band();
      if (!b) return;
      const kind = effect(el);
      if (kind === 'topics') {
        // Topic lines are laid out in the same order as the band's lines.
        const tags = el.dataset.tags!.split(' ');
        b.classList.toggle('spec--focus', on);
        topicLines().forEach((t, i) => b.children[i]?.classList.toggle('is-lit', on && tags.includes(t.dataset.topic!)));
      }
      if (kind !== 'none') on ? startWave() : stopWave();
    };

    // A new page starts fresh; if the mouse is already resting on something
    // (the side menu stays put between pages), its wave carries on.
    document.addEventListener('astro:after-swap', () => {
      clearTimeout(timer);
      hovering = false;
      passEnd = 0;
      const el = target([...document.querySelectorAll(':hover')].pop());
      if (effect(el) !== 'none') startWave();
    });
    document.addEventListener('pointerover', e => hover(e, true));
    document.addEventListener('pointerout', e => hover(e, false));
    document.addEventListener('focusin', e => hover(e, true));
    document.addEventListener('focusout', e => hover(e, false));
  </script>

  <div class="stage" transition:animate="fade">
    <slot />
  </div>

  <script src="/theme-toggle.js" is:inline></script>
</body>
</html>
