---
interface Props {
  title?: string;
  description?: string;
  image?: string;        // path to an OG share image (defaults to the portrait)
}
const {
  title = 'Alessandro Salo — Graphics programmer',
  description = 'Graphics programmer and MSc Game & Media Technology student at Utrecht University — rendering, ray tracing, and optimization.',
  image = '/assets/me.jpeg',
} = Astro.props;

import '../styles/tokens.css';
import '../styles/document.css';
import '../styles/dark-mode.css';
import '../styles/focus-visible.css';
import { ViewTransitions } from 'astro:transitions';

const path = Astro.url.pathname;
// Each nav link is active for its own path plus any it absorbed (Work covers projects and posts).
const sections: Record<string, string[]> = { '/work': ['/work', '/projects', '/blog'], '/about': ['/about'] };
const isActive = (href: string) =>
  href === '/' ? path === '/' : (sections[href] ?? [href]).some(p => path.startsWith(p));

// Absolute URLs degrade gracefully if `site` isn't set in astro.config.mjs.
const base = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(path, base);
const ogImage = new URL(image, base);

const isDefaultImage = image === '/assets/me.jpeg';
const ogImageAlt = isDefaultImage ? 'Alessandro Salo — graphics programmer' : title;
const isHome = path === '/' || path === '';
---
<!doctype html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- No-flash theme boot: set data-theme before first paint, and re-apply
       after every View Transition swap (which otherwise resets <html> to the
       static data-theme="light"). astro:after-swap runs before paint, so the
       saved theme is restored without a flash. -->
  <script is:inline>
    (function () {
      function resolveTheme() {
        try {
          var t = localStorage.getItem('theme');
          if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          return t;
        } catch (e) {
          return 'light';
        }
      }
      function applyTheme() {
        document.documentElement.setAttribute('data-theme', resolveTheme());
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    })();
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Alessandro Salo" />
  <link rel="canonical" href={canonical} />

  <!-- Icons -->
  <link rel="icon" type="image/svg+xml" href="/assets/logo-monogram.svg" />
  <meta name="theme-color" content="#fafaf9" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Alessandro Salo" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={ogImageAlt} />
  {isDefaultImage && <meta property="og:image:width" content="746" />}
  {isDefaultImage && <meta property="og:image:height" content="1066" />}
  <meta property="og:locale" content="en_US" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogImageAlt} />

  <!-- Feeds & discovery -->
  <link rel="alternate" type="application/rss+xml" title="Alessandro Salo — Work" href="/rss.xml" />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <ViewTransitions />
  <slot name="head" />
</head>
<body class:list={[{ 'nav-hidden': isHome }]}>
  <button class="theme-toggle" type="button" aria-label="Toggle dark mode" aria-pressed="false" title="Switch to dark mode" transition:persist>
    <svg class="ic-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.5 13.2A8.5 8.5 0 1 1 10.8 2.5a7 7 0 0 0 10.7 10.7z"></path></svg>
    <svg class="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="currentColor" stroke="none"></circle><line x1="12" y1="1.5" x2="12" y2="4"></line><line x1="12" y1="20" x2="12" y2="22.5"></line><line x1="3.5" y1="3.5" x2="5.3" y2="5.3"></line><line x1="18.7" y1="18.7" x2="20.5" y2="20.5"></line><line x1="1.5" y1="12" x2="4" y2="12"></line><line x1="20" y1="12" x2="22.5" y2="12"></line><line x1="3.5" y1="20.5" x2="5.3" y2="18.7"></line><line x1="18.7" y1="5.3" x2="20.5" y2="3.5"></line></svg>
    <span class="tt-label tt-dark" aria-hidden="true">Dark</span>
    <span class="tt-label tt-light" aria-hidden="true">Light</span>
  </button>

  <nav class="spine" transition:persist>
    <a class="spine-brand" href="/" id="brand-link">AS<b>.</b></a>
    <div class="spine-links">
      <a class:list={[{ active: isActive('/') }]} href="/">Home</a>
      <a class:list={[{ active: isActive('/work') }]} href="/work" data-match="/work /projects /blog">Work</a>
      <a class:list={[{ active: isActive('/about') }]} href="/about">About</a>
      <a href="https://github.com/Adequate88" target="_blank" rel="noopener">GitHub&#8201;&#8599;</a>
    </div>
  </nav>

  <script>
    // The spine persists across view transitions, so its active state is refreshed client-side.
    document.addEventListener('astro:page-load', () => {
      const path = window.location.pathname;
      document.querySelectorAll<HTMLAnchorElement>('.spine-links a').forEach(link => {
        const href = link.getAttribute('href') ?? '';
        if (href.startsWith('http')) return;
        const prefixes = (link.dataset.match ?? href).split(' ');
        link.classList.toggle('active', href === '/' ? path === '/' : prefixes.some(p => path.startsWith(p)));
      });
    });

    // Brand link scrolls to top when already on the home page. Bound once: the spine is persisted.
    document.getElementById('brand-link')?.addEventListener('click', (e) => {
      if (window.location.pathname === '/') {
        e.preventDefault();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });
  </script>

  <div class="stage" transition:animate="fade">
    <slot />
  </div>

  <script src="/theme-toggle.js" is:inline></script>
</body>
</html>
